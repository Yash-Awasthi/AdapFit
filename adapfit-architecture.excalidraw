    {
      "id": "api-content",
      "type": "text",
      "x": 360,
      "y": 125,
      "width": 280,
      "height": 250,
      "text": "REST API (16 endpoints)\n\n• POST /users\n• POST /recovery-logs\n• POST /workouts\n• PATCH /workouts/{id}\n• GET /exercises\n• GET /trends/*\n• WS /ws/{user_id}\n\nPydantic v2 Validation\nCORS + Logging",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,

# AdapFit Environment Variables
# Copy to .env and fill in values

# === Application ===
ENVIRONMENT=development
LOG_LEVEL=info
DEBUG=true

# === Database ===
DATABASE_URL=postgresql://adapfit:adapfit_secret@localhost:5432/adapfit
REDIS_URL=redis://localhost:6379/0

# === Authentication ===
JWT_SECRET_KEY=change-this-to-a-strong-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# === AI/LLM Services (optional) ===
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=

# === Supabase (optional) ===
SUPABASE_URL=
SUPABASE_KEY=

# === External APIs ===
USDA_FOOD_API_KEY=
WEATHER_API_KEY=

# === Security ===
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
RATE_LIMIT_PER_MINUTE=100

# === Email (for notifications) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@adapfit.com

# AdapFit Backend Environment Variables
# Copy this to .env and fill in values

# === Required ===
ENVIRONMENT=development          # development | production
JWT_SECRET_KEY=                  # Secret key for JWT signing (REQUIRED in production)

# === Optional: AI Features ===
GEMINI_API_KEY=                  # Google Gemini API key for AI features (optional, falls back to rule-based)

# === Optional: Database ===
SUPABASE_URL=                    # Supabase project URL (optional, uses in-memory if empty)
SUPABASE_KEY=                    # Supabase anon key (optional, uses in-memory if empty)

# === Optional: CORS ===
ALLOWED_ORIGINS=                 # Comma-separated origins for production CORS

# === Server ===
HOST=0.0.0.0
PORT=8000

{
  "name": "adapfit",
  "version": "2.2.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check:sections": "node --no-warnings scripts/check-sections.mjs",
    "release:apk": "expo prebuild -p android && cd android && gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "release:aab": "expo prebuild -p android && cd android && gradlew bundleRelease",
    "postinstall": "patch-package",
    "e2e": "sh e2e/run.sh",
    "lint": "biome lint --diagnostic-level=error ."
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~58.0.7",
    "expo-asset": "~58.0.13",
    "expo-audio": "~58.0.8",
    "expo-build-properties": "~58.0.10",
    "expo-camera": "~58.0.9",
    "expo-constants": "~58.0.10",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.8",
    "expo-font": "~58.0.7",
    "expo-haptics": "~58.0.5",
    "expo-image": "~58.0.13",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.11",
    "expo-location": "~58.0.13",
    "expo-notifications": "~58.1.2",
    "expo-router": "~58.0.17",
    "expo-secure-store": "~58.0.2",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.7",
    "expo-sqlite": "~58.0.11",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.5",
    "expo-task-manager": "~58.0.11",
    "react": "19.3.0",
    "react-native": "0.88.0-rc.4",
    "react-native-ble-plx": "^3.5.1",
    "react-native-calendars": "~1.1314.0",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-health-connect": "^4.1.3",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-vision-camera": "^5.2.3",
    "react-native-vision-camera-worklets": "^5.2.3",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@biomejs/biome": "^2.5.15",
    "@types/react": "~19.3.0",
    "patch-package": "^8.0.1",
    "typescript": "^7.0.2"
  },
  "private": true,
  "allowScripts": true,
  "overrides": {
    "uuid": "^11.1.1"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}

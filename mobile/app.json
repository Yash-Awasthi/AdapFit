{
  "expo": {
    "name": "AdapFit",
    "slug": "adapfit",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.adapfit.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "AdapFit uses the microphone for hands-free voice workout logging.",
        "NSSpeechRecognitionUsageDescription": "AdapFit transcribes your voice to log sets hands-free.",
        "NSBluetoothAlwaysUsageDescription": "AdapFit connects to Bluetooth heart-rate straps during workouts."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.adapfit.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_BLOOD_GLUCOSE",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.READ_BODY_TEMPERATURE",
        "android.permission.health.READ_NUTRITION",
        "android.permission.health.READ_MENSTRUATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-camera",
        {
          "cameraPermission": "AdapFit uses the camera to check your exercise form during form-checker sessions."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AdapFit uses your photos to log a meal from a picture.",
          "cameraPermission": "AdapFit uses the camera to snap a photo of your meal for logging."
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "AdapFit connects to Bluetooth heart-rate straps during workouts."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 35
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AdapFit uses your location to record the route of a run you start, and to show care, air quality and routes near you when you ask.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "react-native-health-connect",
      [
        "expo-audio",
        {
          "microphonePermission": "AdapFit uses the microphone for voice logging and, when you start it, to listen for snoring overnight. Audio is analysed on the phone and never saved.",
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F172A"
        }
      ],
      "expo-task-manager"
    ],
    "scheme": "adapfit",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:8000",
      "eas": {
        "projectId": "adapfit"
      }
    }
  }
}
